# No environment variables are needed for npm run dev and demo mode.
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Never prefix these with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
JUPITER_API_KEY=
SOLANA_RPC_URL=
RECEIPT_SIGNING_PRIVATE_KEY=
RECEIPT_KEY_ID=capgap-1
MONITOR_SECRET=
RESEND_API_KEY=
EMAIL_FROM=
# Opt-in single-instance fallback; Supabase atomic limits are preferred in production.
ALLOW_MEMORY_RATE_LIMIT=false
